PORT=4000
DATABASE_URL=postgresql://reachinbox:reachinbox_pass@localhost:5432/reachinbox_db?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Real Google OAuth 2.0 Credentials (obtain from Google Cloud Console)
# Authorized JavaScript origin: http://localhost:3000
# Authorized redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

SESSION_SECRET=reachinbox-super-secret-session-key

WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

ETHEREAL_USER=
ETHEREAL_PASS=
